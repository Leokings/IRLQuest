# Local server
IRLQUEST_PORT=8787
IRLQUEST_VERIFIER_MODE=local
IRLQUEST_LOCAL_VERIFIER_DELAY_MS=1400
IRLQUEST_EVIDENCE_SECRET=replace-with-a-long-random-secret

# Optional frontend escape hatch for internal QA only. Keep false in production.
VITE_ALLOW_GALLERY_FALLBACK=false

# Supabase-backed production app. The publishable key is safe to expose in the browser;
# all private data is protected with Auth, RLS, and the irlquest-api Edge Function.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
VITE_SUPABASE_FUNCTION_NAME=irlquest-api

# Required when IRLQUEST_VERIFIER_MODE=genlayer
IRLQUEST_PUBLIC_BASE_URL=https://irlquest.example.com
GENLAYER_RPC_URL=https://studio.genlayer.com/api
GENLAYER_CONTRACT_ADDRESS=0x8E91AF6B3Acdae117c3cec5f2D72D1E23D9E6bA4
GENLAYER_RELAYER_PRIVATE_KEY=0x...
